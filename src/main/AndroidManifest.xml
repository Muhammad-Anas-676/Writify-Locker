<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesCondition" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".VaultApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Writify"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Main Launcher (Decoy Entry) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real Vault Dashboard -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Decoy Notes Webview -->
        <activity
            android:name=".WritifyActivity"
            android:exported="false" />

        <!-- Fallback Lock Screen Overlay Activity -->
        <activity
            android:name=".LockOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Accessibility App Lock Service.
             Runs as a foreground service (with a low-key persistent notification) purely so
             OEM battery managers (Infinix XOS in particular) stop treating it as a killable
             background process. This is what stops the "permission turns off after 1-2 hours"
             issue - the OS was killing the service's process, which also flips the Accessibility
             toggle off as a side effect on some devices. -->
        <service
            android:name=".LockAccessibilityService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the app-lock detection service alive so locked apps stay protected" />
        </service>

    </application>

</manifest>