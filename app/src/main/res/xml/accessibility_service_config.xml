<?xml version="1.0" encoding="utf-8"?>
<!--
    Ultra-lightweight config (Android Go / 1GB-2GB RAM friendly):
    - Only typeWindowStateChanged: the OS does NOT need to walk the view hierarchy for
      any other event type, which is what keeps CPU usage at ~0% at rest.
    - canRetrieveWindowContent=false + no flagRetrieveInteractiveWindows: we never inspect
      node content, only the package name of the event, so none of that overhead is paid.
    - feedbackGeneric + notificationTimeout=0: no debounce delay, no accessibility-feedback
      processing cost.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/app_name"
    android:notificationTimeout="100" />
