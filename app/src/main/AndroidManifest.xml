<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core overlay + query permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesCondition" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Battery optimization exemption — prevents OEM killers from stopping the service -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".VaultApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Writify"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- ══════════════════════════════════════════════════════════════
             ACTIVITIES
        ══════════════════════════════════════════════════════════════ -->

        <!-- Main Launcher — decoy entry point; must stay visible in Recents so the user
             can lock/unlock the app naturally. excludeFromRecents is intentionally absent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real Vault Dashboard -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Decoy Notes WebView -->
        <activity
            android:name=".WritifyActivity"
            android:exported="false" />

        <!-- Fallback lock-screen overlay (used when service overlay is unavailable).
             excludeFromRecents keeps it out of the Recents overview, which is correct — the
             overlay is a transient guard, not a navigation destination. -->
        <activity
            android:name=".LockOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- ══════════════════════════════════════════════════════════════
             ACCESSIBILITY SERVICE — app-lock detection + protection overlays
        ══════════════════════════════════════════════════════════════ -->
        <service
            android:name=".LockAccessibilityService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the app-lock detection service alive so locked apps stay protected" />
        </service>

        <!-- ══════════════════════════════════════════════════════════════
             DEVICE ADMIN RECEIVER — anti-uninstall protection
             Registering as Device Admin causes Android OS to block uninstall
             via Settings → Apps until the user explicitly deactivates admin.
             Our LockAccessibilityService intercepts that deactivation path
             with the protection overlay + inverted-decoy authentication.
        ══════════════════════════════════════════════════════════════ -->
        <receiver
            android:name=".AdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_config" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
