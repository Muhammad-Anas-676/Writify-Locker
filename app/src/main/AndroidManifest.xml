<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core Permissions -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Query packages to display app picker -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".VaultApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Writify"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppLocker">

        <!-- Main PIN Setup / Entry Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher Activity Aliases (Icon & Disguise Swapper) -->
        <activity-alias
            android:name="com.anas.applocker.alias.WritifyAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Writify"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.anas.applocker.alias.CalculatorAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Calculator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.anas.applocker.alias.FileManagerAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="File Manager"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.anas.applocker.alias.NotesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dashboard & App Lock Management -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Decoy Notes Webview Activity -->
        <activity
            android:name=".WritifyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Biometric Unlock Transparent Host -->
        <activity
            android:name=".BiometricUnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.AppLocker.Transparent" />

        <!-- App Picker Activity -->
        <activity
            android:name=".AppPickerActivity"
            android:exported="false" />

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Lock Screen Fallback Activity -->
        <activity
            android:name=".LockOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Fake Storage Decoy Activity -->
        <activity
            android:name=".FakeStorageDetailActivity"
            android:exported="false" />

        <!-- Lock Accessibility Service -->
        <service
            android:name=".LockAccessibilityService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App protection keep-alive overlay service" />
        </service>

        <!-- Boot Receiver for Auto Keep-Alive -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Heartbeat Receiver -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false" />

    </application>

</manifest>
